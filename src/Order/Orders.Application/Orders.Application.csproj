<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- OutboxProcessorService.ProcessDueMessagesAsync is internal so its batch-resilience
         behaviour (issue #44) can be tested without driving the background loop's timing. -->
    <InternalsVisibleTo Include="TallaEgg.AllServices.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.8" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- No TallaEgg.TelegramBot.Infrastructure. The reference sat here dead — every client
         this layer uses (IWalletApiClient, UsersApiClient) is defined in the shared
         TallaEgg.Infrastructure below, and nothing in this project used a bot type — while
         pointing an Orders service layer at the bot's executable assembly, the reverse of the
         direction the bot's own csproj documents (#266). It also made `dotnet publish -r
         linux-x64` of Orders.Api build the bot twice and fail NETSDK1152 (issue #349). Re-adding
         it means the bot's executable has crossed a service boundary backwards; check that is
         really what you want. -->
    <ProjectReference Include="..\..\TallaEgg\TallaEgg.Infrastructure\TallaEgg.Infrastructure.csproj" />
    <ProjectReference Include="..\Orders.Infrastructure\Orders.Infrastructure.csproj" />
    <ProjectReference Include="..\Orders.Core\Orders.Core.csproj" />
  </ItemGroup>

</Project>
