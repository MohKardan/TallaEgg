<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProxyBotClient.ChooseConnection and CreateHttpClient are internal so the connection
         choice can be asserted directly; the ITelegramBotClient they end up inside exposes
         neither its handler nor its timeout source (issue #199). -->
    <InternalsVisibleTo Include="TallaEgg.AllServices.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Telegram.Bot" Version="22.6.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- No Orders.Core. The bot is an HTTP client of the Orders service and speaks to it in DTOs
         from TallaEgg.Core; it has no business linking that service's domain assembly. The
         reference was here only for two dead response classes whose properties named
         Orders.Core.Order, removed in #266 — nothing else in this project ever used a type from
         it. Re-adding it means a domain entity has crossed a service boundary; check that is
         really what you want. -->
    <ProjectReference Include="..\..\src\TallaEgg\TallaEgg.Core\TallaEgg.Core.csproj" />
    <ProjectReference Include="..\..\src\TallaEgg\TallaEgg.Infrastructure\TallaEgg.Infrastructure.csproj" />
    <ProjectReference Include="..\TallaEgg.TelegramBot.Core\TallaEgg.TelegramBot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="..\..\config\appsettings.global.json" Link="Properties\appsettings.global.json" />
  </ItemGroup>

  
</Project> 
